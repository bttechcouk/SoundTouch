# Template — install.sh fills in the @PLACEHOLDERS@ and installs it as a
# systemd *user* service (~/.config/systemd/user/soundtouch-matter.service).
[Unit]
Description=SoundTouch Matter Bridge (Alexa smart home)
After=network-online.target soundtouch.service
Wants=network-online.target soundtouch.service

[Service]
Type=simple
WorkingDirectory=@APP_DIR@/matter_bridge
ExecStart=@NODE@ matter_bridge.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
