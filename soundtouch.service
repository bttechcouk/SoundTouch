# Template — install.sh fills in the @PLACEHOLDERS@ and installs it as a
# systemd *user* service (~/.config/systemd/user/soundtouch.service).
[Unit]
Description=SoundTouch Controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@APP_DIR@
# Optional overrides, e.g. SOUNDTOUCH_TZ=Europe/London or SPOTIFY_CLIENT_ID=…
EnvironmentFile=-@APP_DIR@/data/env
ExecStart=@PYTHON@ @APP_DIR@/soundtouch_controller.py --port @PORT@
Restart=always
RestartSec=10
# The app keeps its own rotating soundtouch.log; console output goes to the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
